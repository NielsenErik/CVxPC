{
    "mlflow": null,
    "experiment": "crack_segmentation",
    "algorithm": "pcnet_ge",
    "device": "cpu",
    "n_cpus": 4,

    "data_path": "data/CrackSeg9k/train",
    "test_path": "data/CrackSeg9k/test",
    "save_path": "models/",
    "validation_split": 0.2,

    "feature_extractor": "cv_modules",

    "cv_epochs": 2,
    "epochs": 20,
    "batch_size": 16,
    "sample_size": 100,
    "test_size": 20,
    "resize_size": [
        128,
        128
    ],
    "input_channels": 3,
    "n_classes": 1,
    "max_depth": 5,
    "max_branching": 3,
    "seed": 90,
    "filter_sizes": [15, 21],
    "n_cv_modules": 10,
    "n_filters": 200,

    "ge":{
        "generations": 1,
        "pop_size": 2,
        "genome_len": 96,
        "crossover_rate": 0.9,
        "mutation_rate": 0.05,
        "elite_k": 2,
        "train_split": 0.2
    },

    "execution_mode": "train"
    

}